{
  "name": "kite-words",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && python3 scripts/export_static.py",
    "start": "npm run cf:dev",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "python3 -m unittest discover -s tests -v",
    "typecheck": "tsc --noEmit",
    "materials": "python3 scripts/build_materials.py",
    "package": "python3 scripts/package_release.py",
    "test:slides": "node --test tests/slides.test.mjs",
    "test:audio": "node --test tests/audio.test.mjs tests/worker-audio.test.mjs",
    "start:legacy": "python3 server.py",
    "cf:prepare": "python3 scripts/cf_prepare.py",
    "cf:types": "wrangler types --config cloudflare/wrangler.jsonc worker-configuration.d.ts --include-runtime false",
    "cf:setup": "node scripts/cf_pipeline.mjs local",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc --persist-to .wrangler/state",
    "cf:deploy": "node scripts/cf_pipeline.mjs deploy",
    "db:migrate:local": "wrangler d1 migrations apply kite-words-db --config cloudflare/wrangler.jsonc --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply kite-words-db --config cloudflare/wrangler.jsonc --remote",
    "assets:push": "node scripts/cf_objects.mjs --remote",
    "assets:pull": "node scripts/cf_pull_audio.mjs",
    "test:cloudflare": "python3 scripts/test_cloudflare.py"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "miniflare": "^5.20260903.0-alpha",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
